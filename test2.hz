fun fib(n) {
    if (n < 2) return n;
    return fib(n - 1) + fib(n - 2);
}

fun main() {
    println("running demo...");
    var before = clock();
    println("The 30th fibonacci number is: " + str(fib(30)));
    var after = clock();
    println("Seconds taken: " + str(after - before));

}

main();